# Flask配置
FLASK_CONFIG=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=True

# 安全配置
SECRET_KEY=change-me-to-a-random-secret

# 数据库配置
DATABASE_URL=sqlite:///zangli.db
DEV_DATABASE_URL=sqlite:///zangli_dev.db

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 藏历配置
TIBETAN_CALENDAR_BASE_YEAR=1027

# DeepSeek AI配置
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# 可选：如需把RAG日志写入文件再启用
# RAG_LOG_FILE=rag_processor.log
