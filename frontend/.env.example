# Local development: Next.js proxies /api requests to this Flask origin.
BACKEND_ORIGIN=http://127.0.0.1:5001

# Production example:
# BACKEND_ORIGIN=https://zangli-backend-api.zeabur.app

# Legacy deployments may keep using a full API base instead:
# BACKEND_API_BASE=https://zangli-backend-api.zeabur.app/api
